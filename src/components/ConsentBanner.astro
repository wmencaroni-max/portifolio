---
import { ShieldCheck } from "lucide-react";
import { perfil, conteudo, rotasPrivacidade, VERSAO_CONSENTIMENTO, type Idioma } from "@/data/perfil";

interface Props { lang: Idioma }
const { lang } = Astro.props;
const c = conteudo[lang].consentimento;
---
<!--
  Banner de consentimento (LGPD). Começa oculto; src/scripts/consentimento.ts mostra quando não há
  escolha salva para a versão atual. Sem JavaScript nada é gravado e nenhuma medição é carregada.
  "Aceitar" e "Recusar" têm o mesmo destaque visual, de propósito.
-->
<section
  id="consentimento"
  class="consent"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consentimento-titulo"
  aria-describedby="consentimento-texto"
  data-versao={VERSAO_CONSENTIMENTO}
  data-ga={perfil.gaId}
  hidden
>
  <div class="flex items-start gap-3">
    <ShieldCheck className="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
    <div class="min-w-0">
      <h2 id="consentimento-titulo" tabindex="-1" class="text-base font-semibold tracking-normal outline-none">{c.titulo}</h2>
      <p id="consentimento-texto" class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
        {c.texto} <a href={rotasPrivacidade[lang]} class="font-medium text-foreground underline underline-offset-2 hover:text-primary">{c.saibaMais}</a>.
      </p>
    </div>
  </div>

  <fieldset class="consent-opcoes mt-4 grid gap-3" data-consent-opcoes hidden>
    <legend class="sr-only">{c.personalizar}</legend>
    <div class="flex items-start justify-between gap-4 rounded-xl border border-border p-3">
      <div>
        <p class="text-sm font-semibold">{c.necessarios}</p>
        <p class="mt-0.5 text-xs text-muted-foreground">{c.necessariosTexto}</p>
      </div>
      <span class="shrink-0 rounded-full bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{c.sempreAtivo}</span>
    </div>
    <label class="flex cursor-pointer items-start justify-between gap-4 rounded-xl border border-border p-3">
      <span>
        <span class="block text-sm font-semibold">{c.estatisticas}</span>
        <span class="mt-0.5 block text-xs text-muted-foreground">{c.estatisticasTexto}</span>
      </span>
      <input type="checkbox" id="consent-estatisticas" class="consent-switch" />
    </label>
  </fieldset>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button type="button" class="consent-btn" data-consent="recusar">{c.recusar}</button>
    <button type="button" class="consent-btn" data-consent="aceitar">{c.aceitar}</button>
    <button type="button" class="consent-btn" data-consent="salvar" hidden>{c.salvar}</button>
    <button type="button" class="ml-auto min-h-11 px-2 text-sm font-medium text-muted-foreground underline underline-offset-2 hover:text-foreground" data-consent="personalizar" aria-expanded="false">{c.personalizar}</button>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-consent-status data-texto={c.salvo}></p>
</section>
