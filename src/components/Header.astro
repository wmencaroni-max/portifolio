---
import { Sun, Moon, Languages } from "lucide-react";
import MobileNav from "@/components/MobileNav";
import { perfil, conteudo, rotas, type Idioma } from "@/data/perfil";

interface Props {
  lang: Idioma;
  /** false em páginas internas: links de seção passam a apontar para a página inicial */
  naHome?: boolean;
  /** Caminho desta página em cada idioma (para o botão de idioma) */
  paginas?: Record<Idioma, string>;
}
const { lang, naHome = true, paginas = rotas } = Astro.props;
const t = conteudo[lang];
const outro: Idioma = lang === "pt" ? "en" : "pt";
const base = naHome ? "" : rotas[lang];
const itens = t.navegacao.map((i) => ({ ...i, href: `${base}${i.href}` }));
---
<header data-header class="sticky top-0 z-40 border-b border-transparent bg-background/70 backdrop-blur-md transition-colors data-[scrolled]:border-border">
  <div class="container-site flex h-[68px] items-center justify-between gap-4">
    <a href={naHome ? "#topo" : rotas[lang]} class="flex items-center gap-3 font-bold" aria-label={`${perfil.nome}, ${t.ui.inicio}`}>
      <span class="bg-grad grid size-[38px] place-items-center rounded-[11px] text-sm font-extrabold tracking-tighter text-[#0b1020]" aria-hidden="true">WM</span>
      <span class="flex flex-col leading-tight">
        <span>{perfil.nomeCurto}</span>
        <span class="hidden text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground sm:block">{t.ui.subMarca}</span>
      </span>
    </a>

    <nav data-nav aria-label={t.ui.menuPrincipal} class="hidden items-center gap-1 lg:flex">
      {itens.map((i) => (
        <a href={i.href} class="whitespace-nowrap rounded-full px-3 py-1.5 text-[0.93rem] font-medium text-muted-foreground transition-colors hover:text-foreground data-[active]:bg-primary/15 data-[active]:text-foreground">
          {i.rotulo}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={paginas[outro]} hreflang={t.ui.outroIdioma.hreflang} lang={t.ui.outroIdioma.hreflang} aria-label={t.ui.outroIdioma.aria} data-lang-switch
        class="flex h-10 items-center gap-1.5 rounded-full border border-border px-3 text-sm font-semibold transition-colors hover:border-primary">
        <Languages className="size-4" aria-hidden="true" />
        {t.ui.outroIdioma.rotulo}
      </a>
      <button data-theme-toggle type="button" aria-label={t.ui.alternarTema}
        class="grid size-10 place-items-center rounded-full border border-border transition-colors hover:border-primary">
        <Sun className="hidden size-[18px] dark:block" aria-hidden="true" />
        <Moon className="block size-[18px] dark:hidden" aria-hidden="true" />
      </button>
      <a href={`${base}#contato`} class="btn-pill btn-primary hidden !px-4 !py-2 text-sm lg:inline-flex">{t.hero.ctaPrincipal}</a>
      <div class="lg:hidden">
        <MobileNav
          client:media="(max-width: 1023px)"
          itens={itens}
          linkedin={perfil.linkedin}
          textos={{
            abrir: t.ui.abrirMenu,
            fechar: t.ui.fecharMenu,
            titulo: t.ui.menuTitulo,
            descricao: t.ui.menuDescricao,
            nav: t.ui.menuMovel,
            cta: t.contato.linkedin,
          }}
        />
      </div>
    </div>
  </div>
</header>
