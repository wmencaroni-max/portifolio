---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { conteudo, rotasPrivacidade, type Idioma } from "@/data/perfil";

interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = conteudo[lang];
const p = t.privacidade;
---
<Layout lang={lang} paginas={rotasPrivacidade} titulo={`${p.titulo} | ${t.ui.subMarca}`} descricao={p.descricao}>
  <Header lang={lang} naHome={false} paginas={rotasPrivacidade} />
  <main id="conteudo" class="py-16 md:py-24">
    <article class="container-site max-w-[760px]">
      <p class="kicker">LGPD</p>
      <h1 class="text-[clamp(2rem,4.5vw,3rem)] font-bold leading-tight">{p.titulo}</h1>
      <p class="mt-3 text-muted-foreground">{p.descricao}</p>
      <p class="mt-1 text-sm text-muted-foreground">{p.atualizado}</p>

      <div class="mt-10 grid gap-8">
        {p.secoes.map((s) => (
          <section>
            <h2 class="text-xl font-semibold tracking-tight">{s.titulo}</h2>
            <p class="mt-2 leading-relaxed text-muted-foreground">{s.texto}</p>
          </section>
        ))}
      </div>

      <p class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#consentimento" data-abrir-consentimento class="btn-pill btn-primary">{t.consentimento.preferencias}</a>
      </p>
      <!-- A CONFIRMAR: remover após revisão jurídica -->
      <p class="mt-8 rounded-xl border border-border bg-card p-4 text-sm text-muted-foreground">{p.aviso}</p>
    </article>
  </main>
  <Footer lang={lang} naHome={false} />
</Layout>
